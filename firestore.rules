rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isCargoOperator() {
      return hasRole('cargo_operator');
    }

    function isFoodVendor() {
      return hasRole('food_vendor');
    }

    function isMarketSeller() {
      return hasRole('market_seller');
    }

    // ================= USERS & KYC PROFILES =================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ================= TWENDE RIDES: ANTI-TAMPER & DOUBLE BOOKING =================
    match /rides/{rideId} {
      // Passengers can read their rides; drivers can read nearby open rides
      allow read: if isAuthenticated();

      // Only customers can initiate a ride request
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;

      // Price Lock & Race Condition Protection:
      // 1. Once status is 'accepted', the agreedFareZMW CANNOT be modified by anyone.
      // 2. A driver can only accept if status is 'offering' (prevents double assignment).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          // Driver accepting a ride: ensures it wasn't already taken
          resource.data.status == 'offering' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.assignedDriverId != null &&
          resource.data.assignedDriverId == null
        ) ||
        (
          // Passenger or driver updating in-transit status without altering locked price
          request.resource.data.agreedFareZMW == resource.data.agreedFareZMW &&
          (resource.data.passengerId == request.auth.uid || resource.data.assignedDriverId == request.auth.uid)
        )
      );

      allow delete: if isAdmin();
    }

    // ================= TWENDE CARGO: FREIGHT & WAYBILL RULES =================
    match /cargo_orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      
      // Prevents multiple operators from claiming the same cargo tender
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.status == 'bidding' &&
          request.resource.data.status == 'assigned' &&
          resource.data.assignedOperatorId == null
        ) ||
        (
          request.resource.data.proposedFareZMW == resource.data.proposedFareZMW &&
          (resource.data.senderId == request.auth.uid || resource.data.assignedOperatorId == request.auth.uid)
        )
      );

      allow delete: if isAdmin();
    }

    // ================= TWENDE FOOD: TOTAL VALIDATION & VENDOR RULES =================
    match /food_orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.restaurantId == request.auth.uid ||
        isAdmin()
      );

      // Server-side calculation verification: subtotal + deliveryFee == total
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.totalZMW == (request.resource.data.subtotalZMW + request.resource.data.deliveryFeeZMW);

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.restaurantId == request.auth.uid && request.resource.data.totalZMW == resource.data.totalZMW)
      );

      allow delete: if isAdmin();
    }

    // ================= TWENDE MARKET: SELLER OWNERSHIP =================
    match /market_products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ================= PLATFORM COMMISSIONS & SETTINGS =================
    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Strictly restricted to Super Admin
    }
  }
}
