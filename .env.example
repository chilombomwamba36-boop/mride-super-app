# ==============================================================================
# MRIDE ADVANCED VECTOR MAP & NAVIGATION CONFIGURATION
# ==============================================================================
# By default, Mride uses OpenFreeMap Liberty Vector Tiles (3D buildings, road
# hierarchy, junctions, POIs) + OSRM Driving Route Engine + Nominatim/Photon
# geocoding with Lusaka landmark enrichment — requiring ZERO paid keys to work.
#
# Optional: Configure any of the public tokens below to switch to commercial
# vector tiles or commercial turn-by-turn routing:

# Optional Mapbox Public Token (pk.*) for Mapbox Streets v12 / Navigation Day
VITE_MAPBOX_PUBLIC_TOKEN=

# Optional MapTiler API Key for MapTiler Streets v2 Vector Style
VITE_MAPTILER_API_KEY=

# Optional Custom MapLibre Vector Style JSON URL
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional Custom OSRM / Valhalla Driving Routing Endpoint
VITE_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# Optional Custom Nominatim / Geocoding Endpoint
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org
